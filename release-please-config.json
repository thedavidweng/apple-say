{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "tag-format": "v${version}",
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "apple-say",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "xml",
          "path": "Resources/Info.plist",
          "xpath": "/plist/dict/key[.='CFBundleShortVersionString']/following-sibling::string[1]"
        },
        {
          "type": "xml",
          "path": "Resources/Info.plist",
          "xpath": "/plist/dict/key[.='CFBundleVersion']/following-sibling::string[1]"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "✨ Features" },
        { "type": "fix", "section": "🐛 Bug Fixes" },
        { "type": "perf", "section": "⚡ Performance" },
        { "type": "refactor", "section": "♻️ Refactoring" },
        { "type": "docs", "section": "📝 Documentation" },
        { "type": "test", "section": "🧪 Tests", "hidden": true },
        { "type": "chore", "section": "🔧 Chores", "hidden": true },
        { "type": "build", "section": "📦 Dependencies", "hidden": true },
        { "type": "ci", "section": "👷 CI/CD", "hidden": true }
      ]
    }
  }
}
